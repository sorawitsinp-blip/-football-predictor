# คัดลอกไฟล์นี้เป็น .env แล้วใส่คีย์ของคุณ

# สมัครฟรีที่ https://www.football-data.org/client/register
# ใช้สำหรับดึงรายการคู่บอล (fixtures) ของแต่ละวัน
FOOTBALL_DATA_API_KEY=

# สร้างที่ https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ไม่บังคับ — สมัครที่ https://parse.bot (AiScore API)
# ถ้าใส่คีย์นี้ ระบบจะดึงสถิติฟอร์ม 5 นัดล่าสุด (ยิง/เสียเฉลี่ยต่อเกม) มาเสริม
# ให้ Claude วิเคราะห์แม่นขึ้น ถ้าไม่ใส่ ระบบจะยังทำงานได้ปกติแค่ไม่มีสถิตินี้
PARSE_API_KEY=
# endpoint เฉพาะของ API นี้ — เช็คค่าล่าสุดจากหน้า Parse ของคุณเอง เผื่อเปลี่ยน
AISCORE_BASE_URL=https://api.parse.bot/scraper/4159e902-84d5-4812-bcee-311effc7486d

# โมเดลที่ใช้วิเคราะห์ (ไม่บังคับ ค่าเริ่มต้น claude-sonnet-5)
CLAUDE_MODEL=claude-sonnet-5

PORT=3000
